# MachineCare AI — example environment file.
# Copy to .env and fill in real values. .env is git-ignored and must
# never be committed; this example only carries placeholders.

# PostgreSQL: compose.yaml requires POSTGRES_PASSWORD; the backend reads DB_*
POSTGRES_PASSWORD=replace-with-a-local-password
DB_USER=machinecare_user
DB_PASSWORD=replace-with-the-same-local-password
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=machinecare_db

# Groq: required for answer generation
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Authentication (Phase 1): required for login, refresh and every
# protected endpoint. Generate a value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value

# Mark the refresh cookie Secure (HTTPS-only transport). Keep false for
# plain-HTTP local development on localhost; set true behind TLS.
COOKIE_SECURE=false

# Optional defaults for the bootstrap admin CLI
# (python -m app.scripts.create_admin). Leave ADMIN_PASSWORD unset so the
# CLI prompts on the terminal instead of storing the password in a file.
#ADMIN_USERNAME=admin
#ADMIN_DISPLAY_NAME=Administrator
#ADMIN_PASSWORD=
